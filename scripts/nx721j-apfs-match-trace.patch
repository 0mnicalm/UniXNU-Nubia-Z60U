+// Diagnostics for the NX721J USB experiment. Leave normal matching decisions alone.
+static uint32_t nx721j_apfs_matching_stages;
+
+extern "C" uint32_t
+nx721j_apfs_match_trace(void)
+{
+	return __atomic_load_n(&nx721j_apfs_matching_stages, __ATOMIC_RELAXED);
+}
+
+static bool
+nx721j_trace_apfs(IOService *provider, const OSString *driverClass)
+{
+	if (!driverClass || !driverClass->isEqualTo("AppleAPFSContainerScheme")) {
+		return false;
+	}
+	auto *hint = provider->copyProperty("Content Hint");
+	auto *type = OSDynamicCast(OSString, hint);
+	const bool isApfsPartition = type && type->isEqualTo("7C3457EF-0000-11AA-AA11-00306543ECAC");
+	OSSafeReleaseNULL(hint);
+	if (!isApfsPartition) {
+		return false;
+	}
+
+	for (unsigned depth = 0; provider && depth < 5; ++depth) {
+		if (provider->metaCast("Nx721jUsbBlock")) {
+			return true;
+		}
+		provider = provider->getProvider();
+	}
+	return false;
+}
+
+static void
+nx721j_apfs_stage(bool trace, unsigned phase)
+{
+	if (trace) {
+		__atomic_fetch_or(&nx721j_apfs_matching_stages, 1U << phase, __ATOMIC_RELAXED);
+	}
+}
