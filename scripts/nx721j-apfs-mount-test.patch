+static int
+nx721j_read_system_version(mount_t mp, vfs_context_t ctx)
+{
+	static const uint8_t expected[SHA256_DIGEST_LENGTH] = {
+		0xe5, 0xed, 0xe4, 0x60, 0xe1, 0xc3, 0xdc, 0x8d,
+		0x43, 0x3f, 0xc1, 0x3d, 0x9c, 0xfc, 0x14, 0xaf,
+		0x1e, 0xc5, 0x94, 0xe8, 0x9b, 0x5d, 0x47, 0x88,
+		0x8a, 0x37, 0x00, 0x31, 0xcd, 0x58, 0x7e, 0x14,
+	};
+	char data[575];
+	uint8_t digest[SHA256_DIGEST_LENGTH];
+	SHA256_CTX sha;
+	vnode_t vp;
+	int resid = sizeof(data);
+
+	int error = vfs_busy(mp, LK_NOWAIT);
+	if (error != 0) {
+		return error;
+	}
+	vnode_t root;
+	error = VFS_ROOT(mp, &root, ctx);
+	if (error != 0) {
+		vfs_unbusy(mp);
+		return error;
+	}
+	error = vnode_lookupat("System/Library/CoreServices/SystemVersion.plist",
+	    VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT, &vp, ctx, root);
+	vnode_put(root);
+	if (error == 0) {
+		if (vnode_mount(vp) != mp || vnode_vtype(vp) != VREG || !vfs_isrdonly(mp)) {
+			error = EINVAL;
+		} else {
+			error = vnode_authorize(vp, NULLVP, KAUTH_VNODE_READ_DATA, ctx);
+		}
+#if CONFIG_MACF
+		if (error == 0) {
+			error = mac_vnode_check_open(ctx, vp, FREAD);
+		}
+#endif
+		if (error == 0) {
+			error = vn_rdwr(UIO_READ, vp, data, sizeof(data), 0, UIO_SYSSPACE, 0,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		}
+		vnode_put(vp);
+	}
+	vfs_unbusy(mp);
+	if (error != 0) {
+		return error;
+	}
+	if (resid != 1) {
+		return EIO;
+	}
+	SHA256_Init(&sha);
+	SHA256_Update(&sha, data, sizeof(data) - 1);
+	SHA256_Final(digest, &sha);
+	return memcmp(digest, expected, sizeof(digest)) == 0 ? 0 : EIO;
+}
