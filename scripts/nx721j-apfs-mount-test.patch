+int nx721j_usb_apfs_readonly_check(const char *device_path, int *mount_step, int *read_error, int *unmount_error);
+
+int
+nx721j_usb_apfs_readonly_check(const char *device_path, int *mount_step, int *read_error, int *unmount_error)
+{
+	struct nameidata nd;
+	vfs_context_t ctx = vfs_context_current();
+	struct nx721j_apfs_mount probe = { .device_path = device_path };
+	*mount_step = NX721J_MOUNT_LOOKUP;
+	const char prefix[] = "/dev/disk";
+	if (strncmp(device_path, prefix, sizeof(prefix) - 1) != 0 ||
+	    strchr(device_path + sizeof(prefix) - 1, '/') != NULL) {
+		return EINVAL;
+	}
+
+	NDINIT(&nd, LOOKUP, OP_MOUNT, NOFOLLOW | NOCROSSMOUNT | WANTPARENT,
+	    UIO_SYSSPACE, CAST_USER_ADDR_T("/mnt"), ctx);
+	int error = namei(&nd);
+	if (error != 0) {
+		return error;
+	}
+	error = mount_common("apfs", nd.ni_dvp, nd.ni_vp, &nd.ni_cnd, USER_ADDR_NULL,
+	    MNT_RDONLY | MNT_NODEV | MNT_NOSUID | MNT_NOEXEC | MNT_DONTBROWSE,
+	    KERNEL_MOUNT_FMOUNT, NULL, ctx, &probe);
+	if (probe.step) {
+		*mount_step = probe.step;
+	}
+	vnode_put(nd.ni_vp);
+	vnode_put(nd.ni_dvp);
+	nameidone(&nd);
+	if (error != 0) {
+		return error;
+	}
+
+	*read_error = nx721j_read_system_version(probe.mount, ctx);
+#if CONFIG_MACF
+	*unmount_error = mac_mount_check_umount(ctx, probe.mount);
+	if (*unmount_error != 0) {
+		mount_drop(probe.mount, 0);
+		return 0;
+	}
+#endif
+	/* safedounmount consumes the reference taken by mount_common. */
+	*unmount_error = safedounmount(probe.mount, 0, ctx);
+	return 0;
 }
 
